# ==============================================================================
# Moneto Platform Environment Configuration
# ==============================================================================

# Node Environment (development | testing | production)
NODE_ENV=development

# Server Configuration
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=moneto_admin
DB_PASSWORD=MonetoSecurePassword2026!
DB_NAME_DEV=moneto_dev
DB_NAME_TEST=moneto_test
DB_NAME_PROD=moneto_prod

# Prisma ORM Database Connection URLs
DATABASE_URL="postgresql://moneto_admin:MonetoSecurePassword2026!@localhost:5432/moneto_dev?schema=public"
DIRECT_URL="postgresql://moneto_admin:MonetoSecurePassword2026!@localhost:5432/moneto_dev?schema=public"

# JWT & Authentication Security
JWT_SECRET=super_secret_moneto_jwt_access_key_change_in_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_moneto_jwt_refresh_key_change_in_production_2026
JWT_REFRESH_EXPIRES_IN=7d

# Argon2id Password Hashing Parameters
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Docker Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
NGINX_PORT=80
POSTGRES_PORT=5432
